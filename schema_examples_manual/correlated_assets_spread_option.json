      "save_results": {
        "final_value": true,
        "time_history": false
      }
    },
    {
      "id": "realized_rho",
      "name": "Realized Correlation",
      "type": "expression",
      "container": "checks",
      "description": "Sample correlation of the two drivers across realizations (run_stat2 corr) \u2014 should reproduce the input rho, validating the Cholesky construction / the engine's correlated draws.",
      "inputs": [
        "Z1",
        "Z2"
      ],
      "expression": {
        "ast": {
          "op": "run_stat2",
          "x": "Z1",
          "y": "Z2",
          "statistic": "corr"
        },
        "display": "corr(Z1,Z2)"
      }
    },
    {
      "id": "beta",
      "name": "CV Coefficient",
      "type": "expression",
      "container": "control_variate",
      "description": "b* = Cov(exchange,spread)/Var(exchange) across realizations.",
      "inputs": [
        "exchange_payoff",
        "spread_payoff"
      ],
      "expression": {
        "ast": {
          "op": "run_stat2",
          "x": "exchange_payoff",
          "y": "spread_payoff",
          "statistic": "beta"
        },
        "display": "beta(exchange,spread)"
      }
    },
    {
      "id": "cv_spread",
      "name": "Control-Variate Estimator",
      "type": "expression",
      "container": "control_variate",
      "description": "Spread-option price estimator with the exchange option as control. Unbiased (E[exchange_payoff]=exchange_price) and much lower variance \u2014 the two payoffs are ~0.99 correlated.",
      "inputs": [
        "spread_payoff",
        "beta",
        "exchange_payoff",
        "exchange_price"
      ],
      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "ref",
            "element_id": "spread_payoff"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "ref",
              "element_id": "beta"
            },
            "right": {
              "op": "subtract",
              "left": {
                "op": "ref",
                "element_id": "exchange_payoff"
              },
              "right": {
                "op": "ref",
                "element_id": "exchange_price"
              }
            }
          }
        },
        "display": "spread_payoff - beta*(exchange_payoff - exchange_price)"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    }
  ]
}