      "type": "expression",
      "container": "reference",
      "description": "Reiner-Rubinstein down-and-out price for CONTINUOUS monitoring at the true maturity T. Discrete monitoring knocks out less often, so the MC price sits ABOVE this (the Sec 3.2.2 bias).",
      "inputs": [
        "B",
        "S0",
        "alpha",
        "bs_price",
        "bsic_price"
