                "op": "subtract",
                "left": {
                  "op": "ref",
                  "element_id": "S_T"
                },
                "right": {
                  "op": "ref",
                  "element_id": "K"
                }
              },
              {
                "op": "literal",
                "value": 0.0
              }
            ]
          }
        },
