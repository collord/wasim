    {
      "id": "run_min",
      "name": "Running Minimum (interior)",
      "type": "filter",
      "container": "path",
      "description": "Cumulative minimum of S over the interior monitoring dates t_0..t_{m-1} (filter min, no window). It misses the terminal fixing S(T) by one step; run_min_T folds that in.",
      "input": "S",
      "statistic": "min",
      "save_results": {
        "final_value": true
      }
    },
    {
      "id": "S_T",
