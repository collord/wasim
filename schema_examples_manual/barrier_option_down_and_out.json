      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "ref",
            "element_id": "bs_price"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "call",
              "fn": "exp",
              "args": [
                {
                  "op": "multiply",
                  "left": {
                    "op": "ref",
                    "element_id": "alpha"
                  },
                  "right": {
                    "op": "call",
                    "fn": "ln",
                    "args": [
                      {
                        "op": "divide",
                        "left": {
                          "op": "ref",
                          "element_id": "B"
                        },
                        "right": {
                          "op": "ref",
                          "element_id": "S0"
