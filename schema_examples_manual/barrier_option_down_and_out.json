              "element_id": "run_min_T"
            },
            "right": {
              "op": "ref",
              "element_id": "B"
            }
          },
          "then": {
            "op": "literal",
            "value": 1.0
          },
          "else": {
            "op": "literal",
            "value": 0.0
          }
        },
        "display": "run_min_T > B ? 1 : 0"
      }
    },
