      "type": "terminal_expression",
      "container": "terminal",
      "description": "The full path minimum over all monitoring dates t_0..t_m: the interior filter minimum folded together with the terminal fixing S(T). The terminal_expression patches the filter's one-step monitoring gap.",
      "inputs": [
        "S_T",
        "run_min"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "min",
          "args": [
            {
              "op": "ref",
              "element_id": "run_min"
            },
            {
              "op": "ref",
              "element_id": "S_T"
            }
          ]
        },
        "display": "min(run_min, S(T))"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    },
