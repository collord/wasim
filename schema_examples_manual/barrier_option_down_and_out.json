{
  "wasim_version": "0.1.0",
  "source": {
    "generator": null,
    "notes": "Discretely monitored down-and-out call priced by path Monte Carlo (Glasserman Sec 3.2.2), maturing at the TRUE T. gap #1: the GBM process drift/vol reference r/sigma. gap #2: the running minimum is an expanding-window filter (min). gap #3: terminal_expression reads S(T) directly, so the vanilla control matures at the true T (mean = Black-Scholes at T, not T_eff) and the terminal fixing is folded into the barrier monitor via min(run_min, S(T)). The plain call is a control variate whose mean is Black-Scholes; barrier_cv is a terminal_expression reading a run_stat2 coefficient. The Reiner-Rubinstein image formula gives the CONTINUOUS-monitoring price; the discrete MC sits above it (Sec 3.2.2 bias), and the BGK continuity correction yields a corrected reference the discrete MC matches. See BARRIER_OPTION_EXAMPLE.md."
  },
  "simulation_settings": {
    "duration": {
      "value": 1.0,
      "unit": "yr"
    },
    "timestep": {
      "value": 0.02,
      "unit": "yr"
    },
    "n_realizations": 100000,
    "sampling_method": "monte_carlo",
    "seed": 90909
  },
