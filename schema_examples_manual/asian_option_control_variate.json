              }
            },
            "right": {
              "op": "ref",
              "element_id": "varG"
            }
          },
          "right": {
            "op": "ref",
            "element_id": "sdG"
          }
        },
        "display": "(muG-lnK+varG)/sdG"
      }
    },
    {
      "id": "dG2",
      "name": "d2",
      "type": "expression",
      "container": "reference",
      "description": "Kemna-Vorst d2.",
      "inputs": [
