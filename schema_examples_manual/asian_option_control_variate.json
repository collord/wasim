    {
      "id": "muG",
      "name": "Geo Log-Mean",
      "type": "expression",
      "container": "reference",
      "description": "E[ln G] for the m equally-spaced dates t_j=j*dt (uses m=cnt, dt).",
      "inputs": [
        "lnS0",
        "r",
        "sigma2",
        "dt",
        "cnt"
      ],
      "expression": {
        "ast": {
          "op": "add",
          "left": {
            "op": "ref",
            "element_id": "lnS0"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "multiply",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "subtract",
                  "left": {
                    "op": "ref",
                    "element_id": "r"
                  },
                  "right": {
                    "op": "multiply",
                    "left": {
                      "op": "literal",
                      "value": 0.5
                    },
                    "right": {
                      "op": "ref",
                      "element_id": "sigma2"
                    }
                  }
                },
                "right": {
                  "op": "ref",
                  "element_id": "dt"
                }
              },
              "right": {
                "op": "subtract",
                "left": {
                  "op": "ref",
                  "element_id": "cnt"
                },
                "right": {
                  "op": "literal",
                  "value": 1.0
                }
              }
            },
            "right": {
              "op": "literal",
              "value": 0.5
            }
          }
        },
        "display": "lnS0 + (r-sigma^2/2)*dt*(m-1)/2"
      }
    },
    {
      "id": "varG",
      "name": "Geo Log-Var",
      "type": "expression",
      "container": "reference",
      "description": "Var[ln G] = (sigma^2/m^2) * sum_ij min(t_i,t_j); -> sigma^2*(m*dt)/3 as m grows.",
      "inputs": [
        "sigma2",
        "dt",
        "cnt"
      ],
      "expression": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "multiply",
            "left": {
              "op": "multiply",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "sigma2"
                },
                "right": {
                  "op": "ref",
                  "element_id": "dt"
                }
              },
              "right": {
                "op": "subtract",
                "left": {
                  "op": "ref",
                  "element_id": "cnt"
                },
                "right": {
                  "op": "literal",
                  "value": 1.0
                }
              }
            },
            "right": {
              "op": "subtract",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 2.0
                },
                "right": {
                  "op": "ref",
                  "element_id": "cnt"
                }
              },
              "right": {
                "op": "literal",
                "value": 1.0
              }
            }
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "literal",
              "value": 6.0
            },
            "right": {
              "op": "ref",
              "element_id": "cnt"
            }
          }
        },
        "display": "sigma^2*dt*(m-1)(2m-1)/(6m)"
      }
    },
    {
      "id": "sdG",
      "name": "Geo Log-Sd",
      "type": "expression",
      "container": "reference",
      "description": "Std of ln G.",
      "inputs": [
        "varG"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "sqrt",
          "args": [
            {
              "op": "ref",
              "element_id": "varG"
