    },
    {
      "id": "geo_price",
      "name": "Geometric Asian Price (exact)",
      "type": "expression",
      "container": "reference",
      "description": "Closed-form price of the geometric-average Asian call. Deterministic across realizations, so its value is the control's known mean E[payoff_geo].",
      "inputs": [
        "disc",
        "muG",
        "varG",
        "NG1",
        "K",
