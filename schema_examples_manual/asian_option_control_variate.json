      "expression": {
        "ast": {
          "op": "multiply",
          "left": {
            "op": "ref",
            "element_id": "disc"
          },
          "right": {
            "op": "call",
            "fn": "max",
            "args": [
              {
                "op": "subtract",
                "left": {
                  "op": "ref",
                  "element_id": "avg_geo"
                },
                "right": {
                  "op": "ref",
                  "element_id": "K"
                }
              },
              {
                "op": "literal",
                "value": 0.0
              }
            ]
          }
        },
        "display": "disc*max(avg_geo-K,0)"
