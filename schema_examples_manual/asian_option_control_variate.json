      "expression": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "add",
            "left": {
              "op": "subtract",
              "left": {
                "op": "ref",
                "element_id": "muG"
              },
              "right": {
                "op": "call",
                "fn": "ln",
                "args": [
                  {
                    "op": "ref",
                    "element_id": "K"
                  }
