          "op": "multiply",
          "left": {
            "op": "ref",
            "element_id": "S"
          },
          "right": {
            "op": "ref",
            "element_id": "P"
          }
        },
        "display": "S*P"
      },
      "min_value": null,
      "capacity": null,
      "save_results": {
        "final_value": true,
        "time_history": true
      }
    },
    {
      "id": "sumS",
      "name": "Sum of S",
      "type": "accumulator",
      "container": "path",
      "description": "Running sum of the path. rate = S/timestep so each Euler step adds one S value. Summed over the monitoring points the average uses.",
      "inputs": [
        "S"
      ],
      "initial_value": {
        "value": 0.0,
        "unit": "USD"
      },
      "rate": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "ref",
