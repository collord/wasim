        "final_value": false,
        "time_history": false
      }
    },
    {
      "id": "S",
      "name": "Underlying Path",
      "type": "accumulator",
      "container": "path",
      "description": "Exact GBM price path: rate = S*P with P the per-step GBM rate makes each Euler step S_{k+1}=S_k*exp(log_ret).",
      "inputs": [
