      "capacity": null
    },
    {
      "id": "sumLnS",
      "name": "Sum of ln S",
      "type": "accumulator",
      "container": "path",
      "description": "Running sum of ln S, for the geometric average.",
      "inputs": [
        "S"
      ],
      "initial_value": {
        "value": 0.0,
        "unit": "USD"
      },
      "rate": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "call",
            "fn": "ln",
            "args": [
              {
                "op": "ref",
                "element_id": "S"
              }
            ]
          },
          "right": {
            "op": "time_ref",
            "property": "timestep"
          }
