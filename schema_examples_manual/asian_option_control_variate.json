      "save_results": {
        "final_value": true,
        "time_history": false
      }
    },
    {
      "id": "payoff_geo",
      "name": "Geometric Asian Payoff",
      "type": "expression",
      "container": "payoffs",
      "description": "Discounted geometric-average Asian call payoff \u2014 the control (known closed-form mean).",
      "inputs": [
