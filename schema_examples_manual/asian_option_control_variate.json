    },
    {
      "id": "cv_arith",
      "name": "Control-Variate Estimator",
      "type": "expression",
      "container": "control_variate",
      "description": "Arithmetic Asian price with the geometric Asian as control. Unbiased (E[payoff_geo]=geo_price) and much lower variance \u2014 the arithmetic and geometric averages are ~0.99 correlated.",
      "inputs": [
        "payoff_arith",
        "beta",
        "payoff_geo",
        "geo_price"
      ],
      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "ref",
            "element_id": "payoff_arith"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "ref",
              "element_id": "beta"
            },
            "right": {
              "op": "subtract",
              "left": {
                "op": "ref",
                "element_id": "payoff_geo"
              },
              "right": {
                "op": "ref",
                "element_id": "geo_price"
              }
            }
          }
        },
        "display": "payoff_arith - beta*(payoff_geo - geo_price)"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    }
  ]
}