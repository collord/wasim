      "type": "accumulator",
      "container": "path",
      "description": "Counts monitoring points (rate = 1/timestep adds 1 per step). Read from an expression it lags one step exactly like sumS/sumLnS, so avg = sumS/cnt is over precisely the points summed \u2014 the lag cancels (engine gap #2 workaround).",
      "inputs": [],
      "initial_value": {
        "value": 0.0,
        "unit": "1"
      },
      "rate": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "literal",
            "value": 1.0
          },
          "right": {
            "op": "time_ref",
            "property": "timestep"
          }
        },
        "display": "1/dt"
      },
      "min_value": null,
      "capacity": null
    },
    {
      "id": "dt",
      "name": "Timestep dt",
      "type": "expression",
      "container": "derived",
      "description": "The simulation timestep, surfaced for the closed-form monitoring spacing.",
      "inputs": [],
      "expression": {
        "ast": {
          "op": "time_ref",
          "property": "timestep"
        },
        "display": "timestep"
      }
    },
    {
      "id": "avg_arith",
      "name": "Arithmetic Average",
      "type": "expression",
      "container": "derived",
      "description": "Arithmetic average of S over the m monitoring points t_j = j*dt, j=0..m-1 (m=cnt). Dividing by the step-counter cnt (not a fixed n) makes the average self-consistent under the one-step stock-read lag.",
      "inputs": [
        "sumS",
        "cnt"
      ],
      "expression": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "ref",
            "element_id": "sumS"
          },
          "right": {
            "op": "ref",
            "element_id": "cnt"
          }
        },
        "display": "sumS/cnt"
      }
    },
    {
      "id": "avg_geo",
      "name": "Geometric Average",
      "type": "expression",
      "container": "derived",
      "description": "Geometric average exp(mean ln S) over the same m points.",
      "inputs": [
        "sumLnS",
        "cnt"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "exp",
          "args": [
            {
              "op": "divide",
              "left": {
                "op": "ref",
                "element_id": "sumLnS"
              },
              "right": {
                "op": "ref",
                "element_id": "cnt"
              }
            }
          ]
