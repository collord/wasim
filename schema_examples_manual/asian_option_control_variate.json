            "args": [
              {
                "op": "subtract",
                "left": {
                  "op": "ref",
                  "element_id": "avg_arith"
                },
                "right": {
                  "op": "ref",
                  "element_id": "K"
                }
              },
              {
                "op": "literal",
                "value": 0.0
              }
            ]
          }
        },
        "display": "disc*max(avg_arith-K,0)"
