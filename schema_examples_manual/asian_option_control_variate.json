        "T"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "exp",
          "args": [
            {
              "op": "neg",
              "operand": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "r"
                },
                "right": {
                  "op": "ref",
                  "element_id": "T"
                }
              }
            }
          ]
