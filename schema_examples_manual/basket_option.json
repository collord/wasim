                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 0.5
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "literal",
                    "value": 1.0
                  },
                  "right": {
                    "op": "call",
                    "fn": "erf",
                    "args": [
                      {
                        "op": "multiply",
                        "left": {
                          "op": "ref",
                          "element_id": "dd1"
                        },
                        "right": {
                          "op": "literal",
                          "value": 0.7071067811865476
                        }
                      }
                    ]
                  }
                }
              }
            },
            "right": {
              "op": "multiply",
              "left": {
                "op": "ref",
                "element_id": "K"
              },
              "right": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 0.5
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "literal",
                    "value": 1.0
                  },
                  "right": {
                    "op": "call",
                    "fn": "erf",
                    "args": [
                      {
                        "op": "multiply",
                        "left": {
                          "op": "ref",
                          "element_id": "dd2"
                        },
                        "right": {
                          "op": "literal",
                          "value": 0.7071067811865476
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "display": "disc[exp(mu_g+var_g/2)N(dd1) - K N(dd2)]"
