      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "multiply",
            "left": {
              "op": "divide",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 2.0
                },
                "right": {
                  "op": "ref",
                  "element_id": "r"
                }
              },
              "right": {
                "op": "ref",
