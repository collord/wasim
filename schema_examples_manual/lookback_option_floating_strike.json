      "parent": null,
      "children": []
    },
    {
      "id": "identity",
      "name": "Identity Check",
      "parent": null,
      "children": []
    },
    {
      "id": "control_variate",
      "name": "Control Variate",
      "parent": null,
      "children": []
    }
  ],
  "elements": [
    {
      "id": "S0",
      "name": "Spot",
      "type": "constant",
      "container": "contract",
      "description": "Current underlying price (also the initial running minimum).",
      "value": {
        "value": 100.0,
        "unit": "USD"
      },
      "editable": true,
      "bounds": {
        "min": 0.0,
        "max": null
      }
    },
    {
      "id": "r",
      "name": "Rate",
      "type": "constant",
      "container": "contract",
      "description": "Annual risk-free rate (drives the GBM drift, referenced live).",
      "value": {
        "value": 0.05,
        "unit": "1"
      },
      "editable": true,
      "bounds": {
        "min": -0.1,
        "max": 1.0
      }
    },
    {
      "id": "sigma",
      "name": "Volatility",
      "type": "constant",
      "container": "contract",
      "description": "Annualized volatility (drives the process vol, referenced live).",
      "value": {
        "value": 0.2,
        "unit": "1"
      },
      "editable": true,
      "bounds": {
        "min": 0.001,
        "max": 3.0
      }
    },
    {
      "id": "T",
      "name": "Maturity (yr)",
      "type": "constant",
      "container": "contract",
      "description": "Maturity; must equal simulation duration.",
      "value": {
        "value": 1.0,
        "unit": "1"
      },
      "editable": true,
      "bounds": {
        "min": 0.01,
        "max": 30.0
      }
    },
    {
      "id": "P",
      "name": "GBM Rate",
      "type": "stochastic_process",
      "container": "path",
      "description": "Per-step risk-neutral GBM rate; drift/vol reference r and sigma (gap #1).",
      "process": {
        "family": "gbm",
        "mean_type": "arithmetic",
        "mean": {
          "ast": {
            "op": "ref",
            "element_id": "r"
          },
          "display": "r"
        },
        "stddev": {
          "ast": {
            "op": "ref",
            "element_id": "sigma"
          },
          "display": "sigma"
        }
      },
      "save_results": {
        "final_value": false,
        "time_history": false
      }
    },
    {
      "id": "S",
