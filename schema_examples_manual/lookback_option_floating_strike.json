        },
        "display": "sqrt(T)"
      }
    },
    {
      "id": "sig2",
      "name": "sigma^2",
      "type": "expression",
      "container": "derived",
      "description": "",
      "inputs": [
        "sigma"
      ],
      "expression": {
        "ast": {
          "op": "multiply",
          "left": {
            "op": "ref",
            "element_id": "sigma"
          },
          "right": {
            "op": "ref",
            "element_id": "sigma"
          }
        },
        "display": "sigma^2"
      }
    },
    {
      "id": "lookback",
      "name": "Lookback Call Payoff",
      "type": "terminal_expression",
      "container": "payoffs",
      "description": "Discounted floating-strike lookback call: buy at the realized minimum, sell at S(T). Always >= 0. No closed form under discrete monitoring.",
      "inputs": [
        "S_T",
        "disc",
        "run_min"
      ],
      "expression": {
        "ast": {
          "op": "multiply",
          "left": {
            "op": "ref",
            "element_id": "disc"
          },
          "right": {
            "op": "subtract",
            "left": {
              "op": "ref",
              "element_id": "S_T"
            },
            "right": {
              "op": "ref",
              "element_id": "run_min"
            }
          }
        },
        "display": "disc*(S(T) - min S)"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    },
    {
      "id": "a1",
      "name": "GSG a1",
      "type": "expression",
      "container": "reference",
      "description": "",
      "inputs": [
        "T",
        "r",
        "sig2",
        "sigma",
        "sqrtT"
      ],
      "expression": {
        "ast": {
          "op": "divide",
          "left": {
            "op": "multiply",
            "left": {
              "op": "add",
              "left": {
                "op": "ref",
                "element_id": "r"
              },
              "right": {
