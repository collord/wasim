              "element_id": "sqrtT"
            }
          },
          "right": {
            "op": "ref",
            "element_id": "a1"
          }
        },
        "display": "(2r/sigma)sqrt(T) - a1"
      }
    },
    {
      "id": "lb_cont",
      "name": "Lookback Price (continuous, GSG)",
      "type": "expression",
      "container": "reference",
      "description": "Goldman-Sosin-Gatto CONTINUOUS-monitoring floating lookback call. Discrete monitoring misses between-date dips, so the discrete min is higher and the discrete MC price sits BELOW this (the Sec 3.2.2 discretization bias, mirror image of the barrier's).",
      "inputs": [
        "S0",
        "a1",
        "a2",
        "argm",
        "disc",
        "ert",
        "r",
        "sig2"
      ],
      "expression": {
        "ast": {
          "op": "add",
          "left": {
            "op": "subtract",
            "left": {
              "op": "multiply",
              "left": {
                "op": "ref",
                "element_id": "S0"
              },
              "right": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 0.5
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "literal",
                    "value": 1.0
                  },
                  "right": {
                    "op": "call",
                    "fn": "erf",
                    "args": [
                      {
                        "op": "multiply",
                        "left": {
                          "op": "ref",
                          "element_id": "a1"
                        },
                        "right": {
                          "op": "literal",
                          "value": 0.7071067811865476
                        }
                      }
                    ]
                  }
                }
              }
            },
            "right": {
              "op": "multiply",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "S0"
                },
                "right": {
                  "op": "ref",
                  "element_id": "disc"
                }
              },
              "right": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 0.5
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "literal",
                    "value": 1.0
                  },
                  "right": {
                    "op": "call",
                    "fn": "erf",
                    "args": [
                      {
                        "op": "multiply",
                        "left": {
                          "op": "ref",
                          "element_id": "a2"
                        },
                        "right": {
                          "op": "literal",
                          "value": 0.7071067811865476
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "multiply",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "S0"
                },
                "right": {
                  "op": "ref",
                  "element_id": "disc"
                }
              },
              "right": {
                "op": "divide",
                "left": {
                  "op": "ref",
                  "element_id": "sig2"
                },
                "right": {
                  "op": "multiply",
                  "left": {
                    "op": "literal",
                    "value": 2.0
                  },
                  "right": {
                    "op": "ref",
                    "element_id": "r"
                  }
                }
              }
            },
            "right": {
              "op": "subtract",
              "left": {
                "op": "multiply",
                "left": {
                  "op": "literal",
                  "value": 0.5
                },
                "right": {
                  "op": "add",
                  "left": {
                    "op": "literal",
                    "value": 1.0
                  },
                  "right": {
                    "op": "call",
                    "fn": "erf",
                    "args": [
                      {
                        "op": "multiply",
                        "left": {
                          "op": "ref",
                          "element_id": "argm"
