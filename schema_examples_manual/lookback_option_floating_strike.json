    {
      "id": "beta",
      "name": "CV Coefficient",
      "type": "expression",
      "container": "control_variate",
      "description": "b* = Cov(ctrl,lookback)/Var(ctrl) across realizations.",
      "inputs": [
        "ctrl",
        "lookback"
      ],
      "expression": {
        "ast": {
          "op": "run_stat2",
          "x": "ctrl",
          "y": "lookback",
          "statistic": "beta"
        },
        "display": "beta(ctrl,lookback)"
      }
    },
    {
      "id": "lookback_cv",
      "name": "Control-Variate Estimator",
      "type": "terminal_expression",
      "container": "control_variate",
      "description": "Lookback price with disc*S(T) as control (known mean S0). Unbiased and lower-variance.",
      "inputs": [
        "S0",
        "beta",
        "ctrl",
        "lookback"
      ],
      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "ref",
            "element_id": "lookback"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "ref",
              "element_id": "beta"
            },
            "right": {
              "op": "subtract",
              "left": {
                "op": "ref",
                "element_id": "ctrl"
              },
              "right": {
                "op": "ref",
                "element_id": "S0"
              }
            }
          }
        },
        "display": "lookback - beta*(ctrl - S0)"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    }
  ]
}