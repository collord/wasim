    {
      "id": "min_mean",
      "name": "E[min S]",
      "type": "expression",
      "container": "identity",
      "description": "Cross-realization mean of the path minimum (run_stat).",
      "inputs": [
        "run_min"
      ],
      "expression": {
        "ast": {
          "op": "run_stat",
          "element_id": "run_min",
          "statistic": "mean"
        },
        "display": "mean(run_min)"
      }
    },
    {
      "id": "lb_check",
      "name": "Lookback via S0 - disc E[min]",
      "type": "expression",
      "container": "identity",
      "description": "The identity price: disc*E[S(T)-min] = disc*E[S(T)] - disc*E[min] = S0 - disc*E[min], since disc*E[S(T)]=S0. Must equal the MC lookback mean (a run_stat consistency check).",
      "inputs": [
        "S0",
        "disc",
        "min_mean"
      ],
      "expression": {
        "ast": {
          "op": "subtract",
          "left": {
            "op": "ref",
            "element_id": "S0"
          },
          "right": {
            "op": "multiply",
            "left": {
              "op": "ref",
              "element_id": "disc"
            },
            "right": {
              "op": "ref",
              "element_id": "min_mean"
            }
          }
        },
        "display": "S0 - disc*E[min S]"
      },
      "save_results": {
        "final_value": true,
        "time_history": false
      }
    },
    {
      "id": "ctrl",
      "name": "Discounted Terminal (control)",
      "type": "terminal_expression",
      "container": "control_variate",
      "description": "Control variate: discounted terminal, known mean disc*E[S(T)] = S0. ~0.9 correlated with the lookback.",
      "inputs": [
        "S_T",
        "disc"
      ],
      "expression": {
        "ast": {
          "op": "multiply",
          "left": {
            "op": "ref",
