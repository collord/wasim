      "type": "accumulator",
      "container": "path",
      "description": "Exact GBM price path (rate = S*P).",
      "inputs": [
        "S",
        "P"
      ],
      "initial_value": {
        "value": 100.0,
        "unit": "USD"
      },
      "rate": {
        "ast": {
          "op": "multiply",
          "left": {
            "op": "ref",
            "element_id": "S"
          },
          "right": {
            "op": "ref",
            "element_id": "P"
          }
        },
        "display": "S*P"
      },
      "min_value": null,
      "capacity": null,
      "save_results": {
        "final_value": true,
        "time_history": true
      }
    },
    {
      "id": "run_min",
      "name": "Running Minimum",
      "type": "filter",
      "container": "path",
      "description": "Cumulative minimum of S over every monitoring date t_0..t_m (filter min, expanding window, include_terminal folds the terminal fixing S(T)). This IS the lookback's floating strike.",
      "input": "S",
      "statistic": "min",
      "include_terminal": true,
      "save_results": {
        "final_value": true
      }
    },
    {
      "id": "S_T",
      "name": "Terminal Price",
      "type": "terminal_expression",
