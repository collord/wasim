{
  "wasim_version": "0.1.0",
  "source": {
    "generator": null,
    "notes": "Floating-strike lookback call priced by path Monte Carlo, maturing at the true T. gap #1: GBM drift/vol reference r/sigma. gap #2/#3: the floating strike is a running minimum via filter(min) with include_terminal folding the terminal fixing S(T); the terminal price is a terminal_expression. The Goldman-Sosin-Gatto continuous formula is the reference; the discrete MC sits below it (Sec 3.2.2 bias: discrete min is less extreme). An in-model run_stat identity (price == S0 - disc*E[min S]) cross-checks the payoff, and disc*S(T) (known mean S0) is a ~0.9-correlated control variate. See LOOKBACK_OPTION_EXAMPLE.md."
  },
  "simulation_settings": {
    "duration": {
      "value": 1.0,
      "unit": "yr"
    },
    "timestep": {
      "value": 0.02,
      "unit": "yr"
    },
    "n_realizations": 100000,
    "sampling_method": "monte_carlo",
    "seed": 70707
  },
  "containers": [
    {
      "id": "contract",
      "name": "Contract & Market",
      "parent": null,
      "children": []
    },
    {
      "id": "path",
      "name": "Path & Minimum Monitor",
      "parent": null,
      "children": []
    },
    {
      "id": "terminal",
      "name": "Terminal Read (gap #3)",
      "parent": null,
      "children": []
    },
    {
      "id": "derived",
      "name": "Derived",
      "parent": null,
      "children": []
    },
    {
      "id": "payoffs",
      "name": "Payoff",
      "parent": null,
      "children": []
    },
