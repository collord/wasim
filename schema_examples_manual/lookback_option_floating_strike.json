                }
              },
              "right": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "ert"
                },
                "right": {
                  "op": "multiply",
                  "left": {
                    "op": "literal",
                    "value": 0.5
                  },
                  "right": {
                    "op": "add",
                    "left": {
                      "op": "literal",
                      "value": 1.0
                    },
                    "right": {
                      "op": "call",
                      "fn": "erf",
                      "args": [
                        {
                          "op": "multiply",
                          "left": {
