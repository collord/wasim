      "type": "expression",
      "container": "derived",
      "description": "Discount to maturity.",
      "inputs": [
        "T",
        "r"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "exp",
          "args": [
            {
              "op": "neg",
              "operand": {
                "op": "multiply",
                "left": {
                  "op": "ref",
                  "element_id": "r"
                },
                "right": {
                  "op": "ref",
                  "element_id": "T"
                }
              }
            }
          ]
        },
        "display": "exp(-r*T)"
      }
    },
    {
      "id": "ert",
      "name": "Growth",
      "type": "expression",
      "container": "derived",
      "description": "",
      "inputs": [
        "T",
        "r"
      ],
      "expression": {
        "ast": {
          "op": "call",
          "fn": "exp",
          "args": [
            {
              "op": "multiply",
              "left": {
                "op": "ref",
                "element_id": "r"
              },
              "right": {
                "op": "ref",
                "element_id": "T"
