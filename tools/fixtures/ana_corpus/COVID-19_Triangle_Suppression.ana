Function OGD_Plot_points(canv, info, roles, ypoints )
Title: Plot points
Definition: Local rxPoints := roles[GraphingRole='X axis', GraphFillerInfo='Value'];~
if IsReference(rxPoints) then (~
	Local xPoints := #rxPoints;~
	Local (x,y) := GraphToCanvasCoord(info,roles,xPoints,yPoints);~
	Local clip := Clip_to_PlotArea(canv,info);~
	CanvasDrawEllipse(clip,x-3,y-3,6,6,fillColor:'Black')~
)
