Function OCD_Draw_tukey_bar( canv, info, roles ; xCat : atom, quantile : [Level] ; Level : Index )
Title: Draw tukey bar
Description: Draws a tukey bar.
Definition: Local swapXY := info[OnGraphDrawItem='SwapXY'];~
Local xAxis := roles[GraphingRole=if swapXY then 'Y axis' else 'X axis'];~
Local xSpan := xAxis[GraphFillerInfo='Max']-xAxis[GraphFillerInfo='Min'];~
Local barWidth := 0.9 * info[OnGraphDrawItem='PlotAreaWidth']/xSpan;~
Local (x,y) := GraphToCanvasCoord( info,roles, xCat, quantile, cluster:Level);~
If swapXY Then ( Local t:=x; x:=y; y:=t; );~
Local x1 := x-barWidth/2, x2 := x+barWidth/2;~
Local x1i := (x1+x)/2, x2i := (x+x2)/2;~
~
LocalIndex I4 := 1..4;~
Local nextY := y[@Level=@Level+1,defVal:null];~
Local nextL := Level[@Level=@Level+1,defVal:null];~
~
for (lev[], lev2[], iL[], y1[], y2[]) := _(Level, nextL, @Level,y,nextY) Do (~
	if lev2<>null then ( ~
		if lev=0 then (~
			CanvasDrawLine(canv,x1,y1,x2,y1,swapXY:swapXY);~
			CanvasDrawLine(canv,x, y1,x, y2, swapXY:swapXY);~
		) else if lev2=1 then (~
			CanvasDrawLine(canv,x1,y2,x2,y2,swapXY:swapXY);~
			CanvasDrawLine(canv,x, y1,x, y2,  swapXY:swapXY);~
		) else if lev=0.5 then (~
			CanvasDrawPolygon(canv, Array(I4,[x1,x1i,x2i,x2]), Array(I4,[y2,y1,y1,y2]), I4,~
				fillcolor:0x40eeeeee,lineColor:'black', swapXY:swapXY);~
		) else if lev2=0.5 then (~
			CanvasDrawPolygon(canv, Array(I4,[x1,x1i,x2i,x2]), Array(I4,[y1,y2,y2,y1]), I4,~
				fillcolor:0x40eeeeee,lineColor:'black', swapXY:swapXY);~
		) else (~
			CanvasDrawRectangle(canv,x1,Min([y1,y2]),barWidth,abs(y2-y1),~
				fillcolor:0x40eeeeee,lineColor:'black', swapXY:swapXY);~
		) ~
	) ~
)
