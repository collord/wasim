Function Plot_point_labels(canv, info, roles; labels : coerce text orNull optional ; hAlign:text = 'Left' ; vAlign:text='Middle' ; fontSize:optional)
Title: Plot point labels~
(canv, info, roles, labels, hAlign, vAlign)
Description: This graph annotations function draws labels on points in a graph. Use this from the OnGraphDraw function.~
~
To use this function:~
• Set OnGraphDraw to evaluate after fully drawn.~
• In your OnGraphDraw, decide on what labels you want to appear at each point. ~
• In your OnGraphDraw expression, call: Plot_Point_Labels( canv, info, roles, labels )~
	where «labels» specifies the labels text.  If labels contains a number, it will be formatted according to the number format for your variable.~
• Set the number format for your calling variable if you are passing in non-text for labels.~
~
You can specify the «labels» in either of two ways.  ~
Method 1: ~
	Specify a pattern. In this case, labels in a single atomic text containing the literal text that you want in the label, along with role substitutions. For example, "(<X axis>, <Y axis>)" will show the values for the X-axis and Y-axis roles in parens. The possible substitutions are the names in the GraphingRole index. If you specify a graphing role that is not present (set to blank), the corresponding substitution used will be the empty text. ~
~
Example usage: Show the Y-axis value on each point:~
	Plot_Point_Labels(canv, info, roles, "<Y axis>" )~
~
Method 2: ~
	Provide an array of values. Here you can compute your own labels. When using this method, you can use Self (which is the Sample value of Mid value, depending on context). Be aware that when you use the value of other variables, you may need to use the corresponding view-mode function. For example, in Mean view mode, use Mean(B), not just B.~
~
Example usage: Show the Y-axis value on each point:~
~
	Local label := #roles[ GraphingRole='Y axis', GraphFillerInfo='Value' ];~
	Plot_Point_Labels(canv, info, roles, label )
Definition: if (info[OnGraphDrawItem='Phase'] = 8 /*after fully drawn*/) then (~
	Local xPt := #roles[GraphingRole='X axis', GraphFillerInfo='Value'];~
	Local yPt := #roles[GraphingRole='Y axis', GraphFillerInfo='Value'];~
	Local cluster := roles[GraphingRole='Cluster', GraphFillerInfo='Value'];~
	cluster := if IsReference(cluster) then #cluster else null;~
~
	Local (xLabel,yLabel) := GraphToCanvasCoord(info,roles,xPt,yPt,cluster:cluster);~
	if size(labels)=1 then (~
		labels := OGD_SubstRoleValues(roles, labels, HandleFromIdentifier("_Caller"))~
	) else (~
		labels := Apply_slicers_to_val(info, labels);~
	);~
	CanvasDrawText(canv, labels, xLabel, yLabel, hAlign:hAlign, vAlign:vAlign, fontSize:fontSize)~
)
NodeLocation: 296,160,1
NodeSize: 160,24
WindState: 2,103,-22,814,741
{!40500|ParameterEnumeration: hAlign~
	'Left'|Text left-aligned to point -- i.e., points to the left of labels~
	'Center'|Labels horizontally centered on point~
	'Right'|Points to the right of labels~
vAlign~
	'Top'|Text vertically top-aligned to points -- i.e., points are at the top of the labels~
	'Middle'|Text vertically centered to points.~
	'Bottom'|Text vertically bottom-aligned to points.}
{!40600|Att_WikiHelpURL: [wiki]}

Function Plot_solid_band( canv :atom ; info : [OnGraphDrawItem]; roles :[GraphingRole,GraphFillerInfo] ; ~
x, lowerY, upperY : [I] ; I : index ; color : color atom = 0x80FFFF00 )
Title: Plot solid band~
(canv, info, roles, x, lowerY, upperY, color )
Description: Plots a solid band between a «lower» and «upper» curve in the given «color» behind the data from an OnGraphDraw attribute expression. To use, enable both "Evaluate before drawing" and "Evaluate after axes, before data".  In your call, you should do an IF on the view mode of interest, for example:~
~
	If info[OnGraphDrawItem='ViewMode']='Sample' Then~
		roleChanges := Plot_Solid_Band( canv, info, roles, x, lowerY, upperY, x, 'LightGreen' )
Definition: Local xx := Concat(x,Reverse(x,I),I,I);~
Local yy := Concat(lowerY, Reverse(upperY,I), I, I, xx.K);~
Local swapXY := info[OnGraphDrawItem='SwapXY'];~
Local phase := info[OnGraphDrawItem='Phase'];~
Local yAxis := roles[GraphingRole='Y axis'];~
~
Local roleChanges[GraphFillerInfo];~
~
if phase=4 then (~
	{ drawing phase }~
	Local (pixX,pixY) := GraphToCanvasCoord(info,roles,xx,yy);~
	Local clip := Clip_to_PlotArea(canv, info);~
	CanvasDrawPolygon( clip, x: pixX, y: pixY, fillColor: color);~
) else if phase=2 and yAxis[GraphFillerInfo='Autoscale'] Then (~
	{ rescaling phase }~
	roleChanges[GraphingRole='Y axis', GraphFillerInfo='IncludeInAutoscale'] := ~
		\([Min(yy, yy.K), Max(yy, yy.K) ]);~
);~
roleChanges
NodeLocation: 296,220,1
NodeSize: 160,24
WindState: 2,74,173,802,735
{!40600|Att_WikiHelpURL: [wiki]}

Function Plot_solid_prob_band( canv :atom ; info : [OnGraphDrawItem]; roles :[GraphingRole,GraphFillerInfo] ; transparency : nonNegative atom = 0 )
Title: Plot solid prob bands~
(canv, info, roles)
Description: Fills in a solid band behind a probability bands view. To be used from the OnGraphDraw attribute. Usage:~
~
• Set "Evaluate before drawing" AND "Evaluate after axes, before data"~
• Set the OnGraphDraw expression to:~
~
	Plot_solid_prob_band( canv, info, roles )~
~
• Select the bands view for your result.~
• Make sure you have Color=.Probability for the pivot.~
~
The color for the lower percentile/fractile is used for the fill. For example, for the 5% to 95% fractile, the color for the 5% fractile is used.~
~
The optional «transparency» parameter is a number between 0.0 and 1.0, that specifies how much transparency to add to the fills. A value of 0 is fully opaque (no transparency), a value of 1.0 is fully transparent (invisible), and a value of 0.5 is partly transparent. Many people opine that transparency:0.5 looks better, and it is nice because the grid shows through. However, the colors only match the key colors exactly when transparency is 0.
Definition: Local colorRole := roles[GraphingRole='Color'];~
Local mode := info[OnGraphDrawItem='ViewMode'];~
Local colorSrc := colorRole[GraphFillerInfo='Source'];~
Local bProbKey := colorRole[GraphFillerInfo='Type']='Index' and identifier of (colorSrc) = '.Probability';~
Local xRole := roles[GraphingRole='X axis'];~
Local bXisIndex := xRole[GraphFillerInfo='Type']='Index';~
Local commonRole := If bXisIndex then xRole Else roles[GraphingRole='Common'];~
Local hasCommon := commonRole[GraphFillerInfo='Type'] = 'Index';~
Local yRole := roles[GraphingRole='Y axis'];~
Local bYisMain := yRole[GraphFillerInfo='Source'] = info[OnGraphDrawItem='Result'];~
Local bCorrectPivot := bYisMain and hasCommon and bProbKey;~
if transparency<0 or transparency>1 then transparency:=0;~
Local alpha := BitShift(Floor((1.0-transparency)*254)+1,24,left:true);~
Local roleChanges := null;~
~
if mode='Bands' and bCorrectPivot Then (~
	LocalAlias common := commonRole[GraphFillerInfo='Source'];~
	Local y := #yRole[GraphFillerInfo='Value'];~
	Local n := IndexLength(y.Probability);~
	LocalIndex Curve := 2..n;~
	Local yUpper := y[@y.Probability=@Curve];~
	Local yLower := y[@y.Probability=Curve];~
	Local x := #roles[GraphingRole='X axis', GraphFillerInfo='Value'];~
	Local color_i := If @Curve<=n/2 Then @Curve else n - @Curve;~
	Local keySeq := #colorRole[GraphFillerInfo='ColorSequence'];~
	Local colorSeq := (keySeq)[@y.Probability=color_i];~
	{ add some transparency -- I think it looks better, even though it distorts the inner colors some }~
	colorSeq := BitOr([alpha,BitAnd([0x00ffffff,colorSeq])]);~
	Plot_solid_band( canv, info, roles, x, yUpper, yLower, common,colorSeq );~
	Local newKeySeq := keySeq[@y.Probability=Min([@y.Probability, n+1-@y.Probability])];~
	roleChanges := ~
		If GraphingRole='Color' and GraphFillerInfo='ColorSequence' Then \newKeySeq else null;~
);~
roleChanges
