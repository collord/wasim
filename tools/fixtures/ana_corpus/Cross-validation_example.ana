var a:=c[Kernel_rec='a'];~
var b:=c[Kernel_rec='b'];~
var m:=c[Kernel_rec='m'];~
d + a*sin(m*x+b)Nodelocation: 184,40,1Nodesize: 56,24Windstate: 2,210,142,476,224Paramnames: c,xFunction Kern_fit(x,y : Array[I] ; I : Index)Title: Kern Fit(x,y,I)Description: Returns a kernel function that fits the data.~
~
This uses the Analytica Optimizer (namely, NlpDefine) to do this.  Th~~
e basic algorithm could be implemented using any algorithm that can s~~
uccessively fit a non-linear function to data.Definition: var lb := if kernel_rec='d' then min(y,I) else 0;~
var maxFreq := 360 * size(I) / (max(X,I)-min(X,I));~
var ub := Array(kernel_rec,[ max(y,I), max(abs(y),I), 360, maxFreq]);~~
 ~
var guess:= if kernel_rec='d' then average(y,I) ~
                                              else random(uniform(lb,~~
ub));~
var c:=0;~
var nlp:=~
  nlpdefine( obj: err(y-kern(c,x),I), vars:kernel_rec, x:c,~
                   lb:lb, ub:ub,~
                   setting:Kern_fit_settings,~
                   guess:guess );~
lpsolution( nlp )Nodelocation: 312,40,1Nodesize: 48,24Windstate: 2,152,161,509,455Paramnames: x,y,IVariable Train_residualTitle: train residualDescription: This is the residual remaining, given the kernel function~~
