Function Clear_all_bevels(m : atomic handle)
Title: Clear All Bevels
Description: Clears the bevel on object m, and on any objects recursively contained within m.
Definition: Set_node_bevel(handle(m),0);~
if IsNull(contains of m) then 1~
else Clear_all_bevels(contains of m);~
0
NodeLocation: 96,176,1
NodeSize: 48,24
WindState: 2,102,90,476,328
Recursive: 1

Function Set_node_bevel(node : variable ; on : atomic boolean)
Title: Set Node Bevel
Description: Sets the node bevel style to either on or off.
Definition: if IsNull(nodeinfo of node) then (~
    if on then ~
        nodeinfo of node := "1,1,1,1,1,1,0,,1,"~
    else ''~
) else (~
  var nv := split(nodeinfo of node,",");~
  index ni := 1..max([9,size(nv)]);~
  var v := if ni=9 then ""&on~
               else if ni>size(nv) then ''~
               else Slice(nv,ni);~
  nodeinfo of node := join(v,ni,",")~
)
