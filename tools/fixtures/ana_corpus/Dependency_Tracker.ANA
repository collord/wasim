Recursive: 1

Function Bevel_all_descendant(node : atomic handle OrNull)
Title: Bevel All descendants of
Description: Bevels node and all its output descendants
Definition: MsgBox(node);~
if node=null then 0~
else if Has_bevel(node) then 0~
else (~
  Set_Node_Bevel(node,1);~
  Bevel_all_descendant(outputs of node);~
  Bevel_all_descendant(dynoutputs of node);~
);~
0
NodeLocation: 320,240,1
NodeSize: 48,24
WindState: 2,87,245,574,305
Recursive: 1

Function Bevel_all_ancestors_(node : atomic handle orNull)
Title: Bevel all ancestors of
Description: Sets the bevel on node and all of its ancestors.
Definition: if node=null then 0~
else if Has_bevel(Handle(node)) then 0~
else (~
  Set_Node_Bevel(Handle(node),1);~
  Bevel_all_ancestors_of_(inputs of node);~
  Bevel_all_ancestors_of_(dyninputs of node)~
);~
0
