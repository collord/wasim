Variable Mortality_rate_by_ti
Title: Mortality rate by Time
Definition: Dynamic(Mortality_parameter*(Weight_*0.2)^-0.25,~
Mortality_parameter*(Weight_by_time[Time-1]*0.2)^-0.25)
NodeLocation: 480,304,1
NodeSize: 56,24
ValueState: 2,52,59,803,538,0,MIDM
ReformVal: [Biomass_platforms,Species]
NumberFormat: 2,%,4,2,0,0,4,0,$,0,"ABBREV",0
Att_ResultSliceState: [Time,4,Strata,1,Species,1,Biomass_platforms,1]

Variable Biomass_increase
Title: Biomass increase
Units: kg
Definition: Dynamic(Biomass_stock*(1-Mortality_rate_by_ti)*Biomass_growth_rates,~
(IF @Time = 2 THEN~
(Self[Time-1]+Biomass_stock)*(1-Mortality_rate_by_ti)*Biomass_growth_rates~
ELSE IF@Time =3 THEN~
(Self[Time-2]+Self[Time-1]+Biomass_stock)*(1-Mortality_rate_by_ti)*Biomass_growth_rates~
ELSE IF@Time = 4 THEN~
(Self[Time-3] + Self[Time-2]+Self[Time-1]+Biomass_stock)*(1-Mortality_rate_by_ti)*Biomass_growth_rates~
ELSE~
(Self[Time-4] + Self[Time-3] + Self[Time-2]+Self[Time-1]+Biomass_stock)*(1-Mortality_rate_by_ti)*Biomass_growth_rates)~
)
