Function showHideFrameNodeUI(isFrameNode)
Title: showHideFrameNodeUI
Definition: { set flag that will stop Set_as_a_frame_node's onchange event to fire }~
AbortMakeFrameNode := 1;~
~
if (isFrameNode) then ~
    (  ~
       toggle_check_box(true, handle(Set_as_a_frame_node ));~
       set_z_level(handle(Set_Frame_Node_Style), 5);~
        set_z_level(handle(HideTitleFormNode), 5); ~
        set_z_level(handle(ShowDescFormNode), 5); ~
        set_z_level(handle(DescLengthFormNode), 5); ~
        set_z_level(handle(TableOrGraphInput), 5); ~
        set_z_level(handle(IndexMenusFormNode), 5);~
        {updateTextNodeUI(select_frame_node); }       ~
    ) ~
    else~
    ( ~
         toggle_check_box(false, handle(Set_as_a_frame_node ));~
          set_z_level(handle(Set_Frame_Node_Style), -5);~
         set_z_level(handle(HideTitleFormNode), -5);~
         set_z_level(handle(ShowDescFormNode), -5);~
         set_z_level(handle(DescLengthFormNode), -5);~
         set_z_level(handle(TableOrGraphInput), -5);~
        set_z_level(handle(IndexMenusFormNode), -5);~
    );~
~
{ UNset flag that will stop Set_as_a_frame_node's onchange event to fire }~
AbortMakeFrameNode := 0;
