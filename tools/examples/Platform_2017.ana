Function setNavStyleAwpAttrib()
Title: setNavStyleAwpAttrib
Definition: /* get the awpAttrib of the top level model */~
var awpAttrib = awp_attrib of (Id_of_top_model);~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAttrib = null) then awpAttrib := "";~
~
/* remove any navigation style attribute */~
AwpAttrib:=clean_newlines(TextReplace(awpAttrib , "Navigation_style:\s*[\w_]*", '', All: True, re: true, caseInsensitive:true));~
~
/* add a new "navigation_style" flag based on choice input navigation_style */~
if (navigation_style = "Tabs across top") then (AwpAttrib:=AwpAttrib&chr(13)&"Navigation_style:top_tabs");~
if (navigation_style = "Tabs down left") then (AwpAttrib:=AwpAttrib&chr(13)&"Navigation_style:side_tabs");~
~
/* update the top level model's awpAttrib */~
 awp_attrib of (id_of_top_model) := awpAttrib;
