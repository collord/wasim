Function Set_table_or_graph()
Title: Set table or graph setting
Description: Sets the flags for showing graph_only, graph_over_table etc. for frame nodes
Definition: /*first remove any previous table or graph flags*/~
var awpAtt := AWP_attrib OF (Select_frame_node) ;~
~
/* if awpAtt is null, make it empty string */~
if (awpAtt = null) then awpAtt:='';~
~
/*remove previous settings if present*/~
awpAtt := textreplace(awpAtt, "graph_only|table_only|table_over_graph|graph_over_table", "", true, true, true);~
~
/* now append the new value */~
awpAtt:=awpAtt&chr(13) & Table_or_graph ;~
AWP_attrib OF (Select_frame_node)  := clean_newlines(awpAtt);
