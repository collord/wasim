Function setTableOrGraph()
Description: Function called via script attriube whenever choice input Select_frame_node changes.~
~
I will update check boxes and choice menu's below this choice input.
Definition: var awpAttrib := awp_attrib of mid(Select_frame_node);~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAttrib = null) then awpAttrib := "";~
~
/* first remove an of the other flags */~
 awpAttrib := TextReplace( AwpAttrib, "Table_only|Graph_only|Table_over_graph|Graph_over_table", "", re:true, caseInsensitive:true, all:true );~
 ~
/* now add the Flag */~
if ( Table_or_graph_ = 2) then (AwpAttrib:=AwpAttrib&Chr(13)&"Graph_only");~
if ( Table_or_graph_ = 3) then (AwpAttrib:=AwpAttrib&Chr(13)&"Table_only");~
if ( Table_or_graph_ = 4) then (AwpAttrib:=AwpAttrib&Chr(13)&"Table_over_graph");~
if ( Table_or_graph_ = 5) then (AwpAttrib:=AwpAttrib&Chr(13)&"Graph_over_table");~
awp_Attrib of mid(Select_frame_node) := clean_newlines(AwpAttrib) ;
