Function getPosValue(nodeid: handle, xyz: text )
Title: getPosValue
Definition: var nl := nodelocation of nodeid;~
var nl_array = Split(nl, ",");~
var posInArray = 1;~
if ( textLowerCase(xyz) = "y") then posInArray:=2;~
if ( textLowerCase(xyz) = "z") then posInArray:=3;~
nl_array[@nl_array=posInArray]
