Function NavStyleScript()
Title: NavStyleScript
Definition: /*Don't want to fire the message boxes in the onchanges in the next  calls, so...*/~
Show_MsgBox_Switch:=False;~
~
/* sets awp_attrib flag for hiding the outline, and updates diagram preview */~
setOutline();~
 ~
/*set hierachy header*/~
setHierHead();~
~
/* if top tabs let's set the awp_attrib , and move the top tabs image and formnode for the 'Include top level diagram as tab' checkbox up */~
if ( Navigation_style = "Tabs across top") then set_z_level(handle(topTabsPict), 10);~
if ( Navigation_style <> "Tabs across top")  then  set_z_level(handle(topTabsPict), -10 );~
~
/* if side tabs let's set the awp_attrib and move the side tabs image up */~
if ( Navigation_style = "Tabs down left") then ( set_z_level(handle(sideTabsPict), 10) );  ~
if ( Navigation_style <> "Tabs down left") then (  set_z_level(handle(sideTabsPict), -10 ));~
~
/*  Set the "Include top level diagram as tab' checkbox */ ~
Show_as_Tab_No();~
~
/* Let's change some of the checkbox options based on using tabs or not */~
/*                                                                                                                    */~
/* first, if using tabs, then 'Use top diagram size for all windows' needs to be checked */~
if (Navigation_style = "Tabs down left" or Navigation_style = "Tabs across top") then~
(~
   /* check the Use_top_diagram_size check box */~
   Definition of Use_top_diagram_size:="checkbox(1)";~
  /* uncheck the ToolbarTabsGreyCb check box */~
   Definition of ToolbarTabsCheckbox:="checkbox(0)";~
  /* uncheck the DiagramTitleCheckBox check box */~
   Definition of DiagramTitleCheckBox:="checkbox(0)";~
  /* uncheck the ParentButtonCheckbox check box */~
   Definition of ParentButtonCheckbox:="checkbox(0)";~
  /* check the Banner_Logo_and_Tabs Checkbox check box */~
   Definition of Banner_logo_and_tabs:="checkbox(1)";~
 ~
/*For Web Application Main style, make the default to not show scroll bars*/  ~
   /*Uncheck the Add_Scroll_Bars checkbox */~
   Definition of Add_Scroll_Bars :="checkbox(0)";~
    setAddScrollBarsNo();~
   ~
~
 /* For Tabs Across Top or Tabs Down Left, generally there's ~
    lots of blank real estate in the Banner, so by default the Model title should show.~
     The ACP code actaully does show the title in this case, but the Style Library GUI  and Preview ~
     also needs to be consistent and indicate this */~
     if (Banner_logo_and_tabs) then~
     (~
       Definition of model_title_checkbox:="checkbox(1)"; /* update checkbox */~
       setModelTitle(); /* update cloudplayerstyles attribute and preview of diagram */~
     );~
~
)~
else ~
(~
  ~
   if (Navigation_style = "Hierarchy headers") then (~
 ~
    /* when HierHeader showing, then don't allow showing diagram title */~
       ~
        /* uncheck the DiagramTitleCheckBox check box */~
       Definition of DiagramTitleCheckBox:="checkbox(0)";~
~
    );~
~
  /*~
  / when changing back from Cloud Application to Analytica Model Review ~
      lets restore the defaults.  So this way preview, gui and cps attrib settings a in sync /~
 ~
  - starting with Parent button~
 */~
  ~
  Definition of Banner_logo_and_tabs:="checkbox(1)";~
  Definition of ParentButtonCheckbox := "CheckBox(1)";~
  Definition of toolbarTabsCheckbox  := "CheckBox(1)";~
  Definition of Use_top_diagram_size := "Checkbox(0)";~
  Definition of Model_title_checkbox :=  "checkbox(0)";~
  Definition of Add_Scroll_Bars :="checkbox(1)";~
  ~
);~
~
 /* next function call will hide ModelTitleMask image */~
~
setModelTitle();~
~
/* next call updates diagram title image on the preview */~
If (Navigation_style = "Outline on left") then definition of DiagramTitleCheckBox := "Checkbox(1)"; ~
Hide_diagram_title();~
~
/* update toolbar tabs and acp attrib */~
setTabs(showMsgBox:Show_MsgBox_Switch);~
~
/* update Banner and tabs images and acp attrib*/~
setHideBanner(Show_MsgBox_Switch);~
~
/* update Diagram title images and acp attrib*/~
setDiagramTitle(showMsgBox:Show_MsgBox_Switch);~
~
/* next call updates parent button image on the preview */~
setParentButton(showMsgBox:Show_MsgBox_Switch);~
~
/* set the "navigation_style: ..." awp_attrib for the top level model */~
setNavStyleAwpAttrib();~
~
/* set Use top diagram size acp attrib */~
setUseTopDiagSize(showMsgBox:Show_MsgBox_Switch);~
~
/* Set scroll bars to be checked by default with Ana model review styles*/~
setAddScrollBarsNo();~
~
/*Now set the msgboxes to fire again when the checkboxes are changed*/~
   Show_MsgBox_Switch:=True;~
1~

