Function Setnumericflagvalue(flag, number :text coerce)
Title: Set numeric flag value
Description: This function set hover balloon delay flag.
Definition: /* cache awpAtt as a local var for brevity */~
var awpAtt := AWP_attrib OF (select_frame_node);~
~
msgbox(awpAtt);~
~
/* remove old flag */~
awpAtt := textreplace(awpAtt, flag&":\s*\d+", "", true, true, true);~
~
msgbox(awpAtt);~
~
/* now append the new value */~
awpAtt:= awpAtt & chr(13)  & flag & ":" & number;~
~
msgbox(awpAtt);~
~
/* Assign local awpAtt to the awp_attrib of the node */~
AWP_attrib OF (select_frame_node) := clean_newlines(awpAtt);
