Function Set_frame_styles()
Title: Set Frame Styles
Description: /* let's tackle easy case first, no awp_attrib present */~
var awpAtt = awp_attrib of Select_module;~
if (awpAtt = null or awpAtt = "") then~
(~
    Msgbox("awp_attrib for frame is empty");~
~
~
)
Definition: Toggle_awp_flag( "show_title:no", ShowTitle, select_frame_node );~
~
SetNumericFlagValue("Show_Description", Description_length); ~
~
if (ShowDescription = 0) then (SetNumericFlagValue("Show_Description", 0); description_length:=0; );~
~
Set_table_or_graph(  )
