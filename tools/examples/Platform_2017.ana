Function setOutline()
Title: setOutline
Definition: /* sets or removes Awp_attrib flag for top level model diagram */~
Toggle_AWP_flag('show_outline:no',   hide_outline);~
~
/* hides outline image on diagram preview */~
/* also moves nodes awp_diagram_title, awp_icons, and awp_nodes horizontally.  If hiding outline, these nodes are shifted to the left, otherwise they are shifted to the right */~
hide_outline_preview(); ~
~
/* updates Use Model Diagram Size images */~
umds();~
~
~
/* if not using the outline, looks like we should be showing the hierarchy header? ~
Well in any case we should not be showing both Outline and Hierarchy header at the same time */~
if ( Navigation_style = "Outline on left") then ( set_z_level(handle(hierHeadPict), -5) );  /*show hh*/~
if ( Navigation_style = "Hierarchy headers") then (  set_z_level(handle(hierHeadPict), 5 )); /*hide hh*/~
0
NodeLocation: 536,163,1
NodeSize: 84,20
WindState: 2,293,104,773,532

Function hide_outline_preview()
Title: hide outline preview
Definition: /* first let's see if outline is showing or not.  Maybe no need to do anything if outline already is in desired state */~
~
var outline_loc := nodelocation of awp_outline;~
var xyz = SplitText( outline_loc, "," );~
var z := evaluate(xyz[@xyz=3]); /* convert from string to number*/~
var outlineShowing = true;~
if (z < 0) then outlineShowing := false;~
~
/* hide/show outline image and shift nodes on diagram left or right accordingly*/~
if (hide_outline and outlineShowing) then~
(~
    {msgbox("Hiding outline " & hide_outline);}~
   set_z_level(handle(awp_outline), -5);  ~
   shift_x_pos(handle(Awp_diagram_title), -horizontal_offset);~
   shift_x_pos(handle(Awp_icons), -horizontal_offset);~
   shift_x_pos(handle(Awp_nodes), -horizontal_offset);~
);~
~
if (not hide_outline and not outlineShowing) then~
(~
   {msgbox("Showing outline: Hiding outline " & hide_outline);}~
   set_z_level(handle(awp_outline), 5);~
   shift_x_pos(handle(Awp_diagram_title), horizontal_offset);~
   shift_x_pos(handle(Awp_icons), horizontal_offset);~
   shift_x_pos(handle(Awp_nodes), horizontal_offset);~
);~
1~

