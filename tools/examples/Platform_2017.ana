Function setDescLength()
Definition: /* get the awpAttrib of the Select_frame_node as a local variable */~
var awpAttrib := awp_attrib of (select_frame_node);~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAttrib = null) then awpAttrib := "";~
~
/* remove any show description attribute */~
AwpAttrib:=TextReplace(awpAttrib , "Show_description: *\d+", '', All: True, re: true, caseInsensitive:true);~
~
/* add a new "Show_description:##" flag based on choice input Description_length */~
AwpAttrib:=AwpAttrib&chr(13)&"Show_description:"&(100*Description_length);~
~
awp_attrib of  mid(select_frame_node) := awpAttrib;
