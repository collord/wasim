(~
  shift_y_pos(handle(awp_nodes), 15)~
~
)~
else if (event="hide_diag_title" and  not DiagramTitleCheckBox)  then~
(~
  shift_y_pos(handle(awp_nodes), -15)~
~
); */~
~
var showingHH := false;~
if (FindInText("hierarchy", TextLowerCase( Navigation_style ))) then showingHH:= true;~
  ~
 if (showingHH or DiagramTitleCheckBox) then (~
  /* showing Hierarchy header */~
   set_y_pos(handle(awp_nodes), 155);~
   set_y_pos(handle(awp_icons), 53);~
  ) else (~
   set_y_pos(handle(awp_nodes), 140);~
   set_y_pos(handle(awp_icons), 37);~
  ); ~
 ~
~
~
{   set_y_pos(handle(awp_nodes), 85);~
   set_y_pos(handle(awp_icons), 53);~
  ) else (~
   set_y_pos(handle(awp_nodes), 70);~
   set_y_pos(handle(awp_icons), 37);~
}
