Function Set_hover_balloon_de(d)
Title: Set_hover_balloon_delay(d: Positive)
Description: Set the delay on showing the balloon to d seconds.
Definition: Reset_global_awp_att := 1;~
/*first remove any previous flag*/~
var awpAtt := AWP_attrib OF (Id_of_top_model) ;~
if (isNull(awpAtt)) then awpAtt := '';~
awpAtt := textreplace(awpAtt, "hover_balloon_delay:\s*\d+", "", true, true, true);~
/* now append the new value */~
awpAtt:= awpAtt & chr(13)  & "hover_balloon_delay:" & (d*1000);~
AWP_attrib OF (Id_of_top_model) := clean_newlines(awpAtt);
