Variable Misc_contig_costs
Title: Misc. Contingency Costs
Units: $
Definition: var pile_removal_costs := Input_decommiss__cos[Decommissioning_cos1="Pile - removal"];~
var dr_contingency := Input_decommiss__cos[Decommissioning_cos1="  contingency portion"];~
var jr_contingency := Input_decommiss__cos[Decommissioning_cos1=" contingency portion"];~
var conductors_cost := Input_decommiss__cos[Decommissioning_cos1="Conductors "];~
var platform_prepcost := Input_decommiss__cos[Decommissioning_cos1="Platform Preparation "];~
var siteclearance_cost := Input_decommiss__cos[Decommissioning_cos1="Site Clearance "];~
var misc_contig_pcent := .15;~
misc_contig_pcent*(pile_removal_costs + dr_contingency + jr_contingency + conductors_cost + platform_prepcost + siteclearance_cost)
NodeLocation: 216,64,1
NodeSize: 56,32
