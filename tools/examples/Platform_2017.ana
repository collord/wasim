Function setTabs(showMsgBox)
Description: Tool Bar Tabs
Definition: /*This will remove the flag, if present , remove any blank lines, and then add the flag back again*/~
~
Toggle_AWP_flag('show_tabs:no', not ToolbarTabsCheckbox );~
~
/*This flag is not compatible with the Banner and Logo hidden, so check to see if that checkbox is empty, and if so, display a message and uncheck this checkbox*/~
~
if (not  Banner_logo_and_tabs and ToolbarTabsCheckbox) then (~
  msgbox("When '" &(title of Banner_logo_and_tabs)& "' is unchecked you cannot display the Toolbar Tabs because the Toolbar Tabs is shown in the banner region.", 0);  ~
  Definition of ToolbarTabsCheckbox:="checkbox(0)";~
~
/*Toggle the flag again if the message box showed, since the checkbox is now false. */~
~
Toggle_AWP_flag('show_tabs:no', not ToolbarTabsCheckbox );~
~
) ~
~
/*Assuming the Banner and Logo checkbox is checked - the most common case, continue with the rest of the function*/~
~
else if (Navigation_style = "Tabs down left" or Navigation_style = "Tabs across top") then (~
 {tool bar tabs not compatible}~
 Definition of ToolbarTabsCheckbox:="checkbox(0)";~
~
/*Display a message that you cannot check this checkbox if Navigation style is Tabs down left or Tabs across top */~
if (showMsgBox=True) then~
msgbox("Toolbar Tabs are not compatible with the 'Web application' " &(title of Main_style), 0); ~
) ~
~
else ~
(~
  if (ToolbarTabsCheckbox) then set_z_level(handle(awp_tabs), 5) else set_z_level(handle(awp_tabs), -5);~
)~

NodeLocation: 136,80,1
NodeSize: 84,20
WindState: 2,318,14,673,618

Function setHideBanner(showMsgBox)
Title: setHideBanner
Definition: /* set or unset the 'hide_banner:yes' flag*/~
Toggle_AWP_flag('show_banner:no', not Banner_logo_and_tabs );~
~
/* hide or show banner image, includes lumina logo and white banner at top of model*/~
if (not Banner_logo_and_tabs) then  set_z_level(handle(awp_banner), -5)  else set_z_level(handle(awp_banner), 1);~
if (not Banner_logo_and_tabs) then  set_z_level(handle(blueBackForHideBanne), 12)  else set_z_level(handle(blueBackForHideBanne), -5);~
if (not Banner_logo_and_tabs) then  set_z_level(handle(model_title), -5)  else set_z_level(handle(model_title), 5);~
~
Show_MsgBox_Switch:=False;~
if (not Banner_logo_and_tabs) then ~
(~
  toggle_check_box(false, handle(ToolbarTabsCheckbox));~
  toggle_check_box(false, handle(ParentButtonCheckbox));~
  toggle_check_box(false, handle(Model_title_checkbox));~
);~
~
evaluatescript( onChange of handle(ToolbarTabsCheckbox) );~
evaluatescript( onChange of handle(ParentButtonCheckbox) );~
evaluatescript( onChange of handle(Model_title_checkbox) );~
~
if (showMsgBox) then~
Show_MsgBox_Switch:=True else null;~
~
/* move up z level for top tabs navigation */
