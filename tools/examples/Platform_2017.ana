Function umds()
Title: Use Model Diagram Size
Definition: /* move all white background objects to back, out of site */~
  set_z_level(handle(umds_right_wOut), -5);~
  set_z_level(handle(umds_botm_1),-5);~
  set_z_level(handle(umds_right_woOut),-5);~
  set_z_level(handle(btom_noDiagTitle),-5);~
  set_z_level(handle(white_block_1),-5);~
~
if (Use_top_diagram_size) then (~
~
   if (Navigation_style = "Hierarchy headers") then~
   ( ~
~
       set_z_level(handle(umds_botm_1),9);~
       set_z_level(handle(umds_right_woOut),10);~
        /*~
        if (not DiagramTitleCheckBox) then (~
        ) ~
        else~
        (~
~
            set_z_level(handle(btom_noDiagTitle),9);~
            set_z_level(handle(umds_right_woOut),10);~
            set_z_level(handle(white_block_1),11);~
        ) */~
   ~
   )~
   else if (Navigation_style = "Outline on left") then~
   (~
    /* here we are showing outline */~
      set_z_level(handle(umds_right_wOut), 10);~
      ~
      if (DiagramTitleCheckBox) then ~
      ( ~
        set_z_level(handle(umds_botm_1),10)  /* if Diagram title check box is checked */~
      ) ~
      else ~
      (~
         set_z_level(handle(btom_noDiagTitle),10)  /* if Diagram title check box is NOT checked */~
      );~
    ) else (0);~
)~
else~
(~
  0; /* do nothing */ ~
)
