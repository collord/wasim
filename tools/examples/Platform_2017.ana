Definition: Reset_global_awp_att := 1;~
~
/* copy awp_attrib to local variable so it's easy to manipulate */~
var awpAtt := AWP_attrib OF (Id_of_top_model) ;~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAtt = null) then awpAtt := "";~
~
/*first remove any previous flag*/~
awpAtt := textreplace(awpAtt, "glow_hover_highlight:\s*yes", "", true, true, true);~
awpAtt := textreplace(awpAtt, "show_hover_highlight:\s*no", "", true, true, true);~
~
/* now append the new value */~
if (Node_effect_on_mouse = "Glow") then awpAtt:= awpAtt & chr(13)  & "glow_hover_highlight:yes";~
if (Node_effect_on_mouse = "None") then awpAtt:= awpAtt & chr(13)  & "show_hover_highlight:no";~
{ note, the 'Outline' effect is the default, so no flag set in this case }~
~
/* now copy over to attribute of top level */~
AWP_attrib OF (Id_of_top_model) := clean_newlines(awpAtt);~
~
/*~
 upate preview~
*/~
~
/*first move all images backward*/~
set_z_level(handle(node_effect_none), -10);~
set_z_level(handle(node_effect_highligh), -10);~
set_z_level(handle(node_effect_glow), -10);~
~
~
/* now move one of the images forward */~
if (Node_effect_on_mouse = "None") then set_z_level(handle(node_effect_none), 10);~
if (Node_effect_on_mouse = "Glow") then set_z_level(handle(node_effect_glow), 10);~
if (Node_effect_on_mouse = "Outline") then set_z_level(handle(node_effect_highligh), 10);~
~
1
