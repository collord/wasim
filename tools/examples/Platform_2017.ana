Function Show_As_Tab_No()
Title: Show_As_Tab:No
Description: 1. Show the "Include top level diagram as tab" checkbox if the Navigation style is top tabs or tabs down left~
2: Show the preview picture if the checkbox is not checked.~
3: Sets the CloudplayerStyle flag for the top diagram.
Definition: /* Show/Hide the checkbox since it's only usable if the Nav style is Tabs across top of Tabs down left, and set it to true if the module as tab if the nav style is not "tabs across top" of Tabs down left */~
~
If (Main_style="Web application")~
	then ((SetNodeZ(Handle(Include_top_level_di), 10));~
		Definition of Show_As_Tab_Checkbox := "Checkbox(0)");~
~
If (Main_style <> "Web application" ) ~
	then ((SetNodeZ(Handle(Include_top_level_di), -10));~
		 Definition of  Show_As_Tab_Checkbox := "Checkbox(1)");~
~
~
Toggle_awp_flag('Show_As_Tab:No', Not Show_As_Tab_Checkbox);~
~
If ( Navigation_style = "Tabs across top" ) and (not  Show_As_Tab_Checkbox)~
	then (set_z_level(handle(ShowAsTabNoPict), 10)) ~
	else (set_z_level(handle(ShowAsTabNoPict), -10));~
~
If ( Navigation_style = "Tabs down left" ) and (not  Show_As_Tab_Checkbox)~
	then (set_z_level(handle(SideTabShowAsTabNo), 10)) ~
	else (set_z_level(handle(SideTabShowAsTabNo), -10));~

