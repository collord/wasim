Function onSelectFrameNode()
Description: Function called via script attriube whenever choice input Select_frame_node changes.~
~
I will update check boxes and choice menu's below this choice input.
Definition: var awpAttrib := awp_attrib of mid(Select_module);~
~
/* if the awp_attrib is null, make it empty string so concatenation works */~
if (awpAttrib = null) then (awpAttrib := ""; MsgBox("making awpAttrib null"));~
~
if (findintext( "FrameNode", awpAttrib,  caseInsensitive: true )) then~
( ~
    var frameNodes := FindInText( "FrameNode:([\w\&]*)", awpAttrib , caseInsensitive: true, re:true, return:'S', subpattern: 1);~
    var frameNodeArray = TextLowerCase( SplitText( frameNodes , "&" ) );~
~
    var isFrameNode := Sum(TextLowerCase(select_frame_node) = frameNodeArray);~
    ~
   showHideFrameNodeUI(isFrameNode);~
~
) else showHideFrameNodeUI(false);~
~
/* if there are no text node's present, and select_frame_node says something like "No frame nodes found" then hide~
checkbox for 'Use as a module frame node */~
if (select_frame_node =  No_text_nodes_string) then Set_z_level(handle(UseAsFrameNodeCb), -5) else Set_z_level(handle(UseAsFrameNodeCb), 5); ~
~
