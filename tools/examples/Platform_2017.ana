Function UseAsFrameTemp()
Title: UseAsFrameTemp
Description: Ensures that the use As Frame Node form node and checkbox will be visible in the Frame Node diagram, when text nodes are present on the diagram. A temporary workaround for EW13113
Definition: refreshFrameNodeList();~
~
var textNodes := Objectsinclass( Select_module, 'Text' );~
/*var selectTextNode = ['Select a text node'];*/~
if textNodes = null then ~
(~
   /* if no text nodes are found on the diagram~
      display "No text node's found" on Select Frame Node choice input~
      and hide the "Use as a module frame node" check box */~
   textnodes:= ["No text nodes found"] ;~
    set_z_level(handle(UseAsFrameNodeCb), -5);~
)~
else ~
(~
  /* if text nodes are found, show check box for "Use as module frame node" */~
    textNodes:=~
    set_z_level(handle(UseAsFrameNodeCb), 5);  ~
);~
textnodes;
