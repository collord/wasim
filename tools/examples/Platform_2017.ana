Function setDiagramTitle(showMsgBox)
Description: Toggle_AWP_flag('show_diagram_title:no', not DiagramTitleCheckBox);~
Hide_diagram_title(); /* hides or shows diagram title images */~
Set_Node_yPos("hide_diag_title");~
if (Use_top_diagram_size) then umds()
Definition: /*not sure how good support for Diagram Title is, disable for now, eventually update preview and no need for this checkbox*/~
~
if (Navigation_style = "Tabs down left" or Navigation_style = "Tabs across top") then (~
Definition of DiagramTitleCheckBox:="checkbox(0)";~
~
if (showMsgbox=True) then ~
  msgbox("The Diagram Title can't be displayed with the 'Web application' " &(title of Main_style), 0);~
~
)~
~
~
else if (Navigation_style = "Hierarchy headers") then~
( ~
   {similarly don't show diagram title when using Hierachy headers, may actually work ok in ACP, ~
   but not supported in Style library preview.  Also the title is a bit redundant in this case, since~
   the mode title is being shown in bold in the Hier Header}~
~
if (showMsgBox=True) then~
/*Display a message that you cannot check this checkbox if Navigation style is Hierarchy headers */~
msgbox("The Diagram Title is disabled in the Styles Library with the 'Hierarchy headers' " &(title of Navigation_style) & ". It's redundant since the Module title is shown in the Hierarchy header itself.", 0); ~
~
    Definition of DiagramTitleCheckBox:="checkbox(0)";~
    1;~
) ~
else ~
(~
  Toggle_AWP_flag('show_diagram_title:no', not DiagramTitleCheckBox);~
  Hide_diagram_title(); /* hides or shows diagram title images */~
  Set_Node_yPos("hide_diag_title");~
  if (Use_top_diagram_size) then umds();~
   1;~
)~

