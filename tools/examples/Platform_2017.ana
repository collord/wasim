Library Tornado_functions1
Title: Tornado functions
Author: Lonnie
Date: Thu, Apr 17, 2008 10:12 AM
SaveAuthor: Surya Swamy
SaveDate: Wed, Oct 21, 2009 3:32 PM
NodeLocation: 560,48,1
NodeSize: 48,24
DiagState: 2,800,132,596,399,17

Function Make_tornado1( result : variable ; vars :  index ; ~
values : Array[vars, levels] ; levels : index )
Title: Make_Tornado
Description: This computes a tornado by computing the result value as each of the inputs is varied individually among the indicated values.  The values are indexed by a levels index, and the function sorts the results so that the variables with the maximum variation across levels are listed last.  The result is indexed by levels and by a local index, sorted_{vars}.
Definition: var unsortedTornado := WhatIfAll( result, vars, values );~
var spread := max(unsortedTornado,Levels) -~
                       min(unsortedTornado,Levels);~
{ if there are other dimensions, we need to look at the overall spread to get a single sort order }~
spread := Maxall1(spread,vars);~
var newIndexName = "sorted_"&(identifier of vars) ;~
metaindex sorted_inputs / newIndexName := sortIndex(-spread);~
title of sorted_inputs := title of vars;~
unsortedTornado[vars = sorted_inputs]
NodeLocation: 96,48,1
NodeSize: 60,24
WindState: 2,158,94,746,453

Function Maxall1(x : array[I] ; I : optional indexType)
Title: MaxAll
Description: Find the maximum over all dimensions in X.~
If an optional index is specified, it finds the max over all dimensions EXCEPT I.
Definition: if IsNotSpecified(I) then begin~
  if size(IndexNames(x))=0~
  then x~
  else Maxall1(Max(x))~
end else begin~
  var v:=x in  I do Maxall1(v)~
end
NodeLocation: 256,56,1
NodeSize: 48,24
WindState: 2,102,90,494,297
Recursive: 1

Function Tornado2(result: Unevaluated; inputs: index of handle; ~
inputRanges: array; Levels: index)
Title: Tornado
Description: Produces a sorted tornado, sorting by the average bar width.
Definition: Widthsort1(Whatifall(result, inputs, inputRanges), Inputs, levels )
NodeLocation: 72,144,1
NodeSize: 48,24
WindState: 2,-30,474,614,391

Function Average_all_except1(x ; Except : Index)
Title: Average all except
Description: Averages over all elements in all dimensions of x except the one index indicated.
Definition: var n := 1;~
for J := indexesOf(x) do (~
     if handle(J) <> Handle(Except) then (~
         n := n * size(IndexValue(J));~
         x := sum(x,J)~
     )         ~
);~
x/n
NodeLocation: 208,176,1
NodeSize: 48,24

Function Widthsort1( vals ; InputVars, Level : Index)
Title: WidthSort
Description: Sorts vals along the InputVars index according to average bar width.
Definition: var width := Average_all_except1( Mean(Max(vals,Level) - Min(Vals,Level)), InputVars );~
Index SortedVars / (identifier of InputVars) := SortIndex(-width);~
vals[InputVars=SortedVars]
NodeLocation: 184,112,1
NodeSize: 48,24
WindState: 2,98,83,791,309

