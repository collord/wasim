ValueState: 2,838,688,416,303,0,MIDM
Aliases: FormNode UseAsFrameNodeCb
NodeColor: 65535,65535,65535
OnChange: if (not AbortMakeFrameNode) then (MakeModuleFrameNode());

Function MakeModuleFrameNode()
Title: Use as Module Frame Node
Definition: /* update the AWP Attrib ~
*~
*~
*/~
~
var awpAttrib = awp_attrib of mid(Select_module);~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAttrib = null) then awpAttrib := "";~
~
if ( Set_as_a_frame_node) then ~
(~
   /* if there's no "FrameNode" flag in the awp attribute setting, add one */~
   if ( not findintext( "FrameNode", awpAttrib,  caseInsensitive: true )  ) ~
     then  (awpAttrib:= awpAttrib &chr(13)&"FrameNode:"&Select_frame_node) ~
     /*else if there already is a "FrameNode" flag, let's add this one.*/~
     else ( awpAttrib:=TextReplace( awpAttrib,  "FrameNode:([\w\&])*", "\0&" & Select_frame_node , caseInsensitive: true, re:true) );~
~
)~
else~
(~
  /* remove frame node flag */~
  /* if there's just one frame node, then remove whole framenode flag, to see if there is more than one, look for '&' in FrameNode flag */~
  var frameNodes := FindInText( "FrameNode:([\w\&])*", awpAttrib , caseInsensitive: true, re:true, return:'S');~
  var hasAmp := FindInText("&", frameNodes);~
  /* so if there's an amp, we need to remove just the node id and an amp from the FrameNode flag */~
  if ( hasAmp ) then~
  (~
      /*this will remove the frame node if comes first in the list of frame nodes*/~
       awpAttrib :=TextReplace( awpAttrib, "FrameNode:" & Select_frame_node & "&",  "FrameNode:", caseInsensitive: true, re:true);~
~
      /*This will remove the frame node if it comes in the midde or end of the list of frame nodes*/~
         awpAttrib :=TextReplace( awpAttrib, "(FrameNode:[\w\&]+)" & "&" & Select_frame_node,  "\1", caseInsensitive: true, re:true);~
  )~
  else~
   (~
        awpAttrib := TextReplace(awpAttrib, "FrameNode:\w*", "",   caseInsensitive:true, re:true);~
   ~
   );~
~
);~
awp_attrib of mid(Select_module) :=  clean_newlines(awpAttrib);~
~
/* * * ~
* Update the UI, that is if the Select Frame Node is being made a text node, then show ~
* formnodes for FrameNode settings (e.g. hide tite?...).  If text node is being removed from list of module frame nodes, ~
* then hide these form nodes~
*/~
  ~
    if (Set_as_a_frame_node) then ~
    (  ~
        set_z_level(handle(Set_Frame_Node_Style), 5);~
        set_z_level(handle(HideTitleFormNode), 5); ~
        set_z_level(handle(ShowDescFormNode), 5); ~
        set_z_level(handle(DescLengthFormNode), 5); ~
        set_z_level(handle(TableOrGraphInput), 5);~
        set_z_level(handle(IndexMenusFormNode), 5);~
     ~
        /* give ui default values of checked for title and description, and description at 30% */~
        toggle_check_box( false, handle(Show_index_menus));~
        toggle_check_box( true, handle(ShowTitle));~
        toggle_check_box( true, handle(ShowDescription));~
        Definition of Description_length := 'Choice(self,3,0)';~
        Definition of Table_or_graph := 'Choice(self,1,0)';~
     ~
       /* if frame node already has CPS attribute with frame node settings, then update UI accordingly to match those settings */        ~
       updateTextNodeUI(select_frame_node);   ~
       ~
~
    ) ~
    else~
    ( ~
         set_z_level(handle(Set_Frame_Node_Style), -5);~
         set_z_level(handle(HideTitleFormNode), -5);~
         set_z_level(handle(ShowDescFormNode), -5);~
         set_z_level(handle(DescLengthFormNode), -5);~
          set_z_level(handle(TableOrGraphInput), -5);   ~
          set_z_level(handle(IndexMenusFormNode), -5);~
    );~
~
0~

