Function setHideDescription()
Definition: var awpAttrib = awp_attrib of mid(select_frame_node);~
~
/* if the awp_attrib is null, make it empty string so concentenation works */~
if (awpAttrib = null) then awpAttrib := "";~
~
~
if (not ShowDescription) then ~
( ~
/* so if we are hiding the description, then also hide the choie input node description length */~
  set_z_level( handle(DescLengthFormNode), -5) ;~
/* remove any "show_description" flag that may be present */~
  awpAttrib := TextReplace( AwpAttrib, "Show_description:\d*", "", re:true, caseInsensitive:true, all:true );~
/* then add the "show_description:0" flag to suppress any description */~
  awpAttrib := awpAttrib&chr(13)&"show_description:0";~
~
)~
else~
(~
/* so if we are Not hiding the description, then also Not hide the choie input node description length */~
   set_z_level( handle(DescLengthFormNode), 5);~
/* set the choice node setting to 30%, the default value for when no Show_description:## flag is present */~
    Definition of Description_length := 'Choice(self,4,0)';~
/* Remove flag 'Show_description:##' from frame node attribute if present */~
   awpAttrib := TextReplace( AwpAttrib, "Show_description:\d*", "", re:true, caseInsensitive:true, all:true );~
);~
~
awp_attrib of mid(select_frame_node) := clean_newlines(awpAttrib);~

