Function updateTextNodeUI(frameNode: handle)
Title: updateTextNodeUI
Description: When the choice input for Select Frame Node is changed to a node that is being used as a frame node, then the UI for things like 'Hide Title' and 'Show Description' need to be updated based on the awp_attribute of the frame node.
Definition: var awpAttrib := awp_attrib of framenode;~
~
/* Update Show_index_nenus */~
var showIndexMenus := false;~
if (FindInText( "Show_index_menus: *Yes", awpAttrib, re:true, caseInsensitive:true )) then (showIndexMenus:=true);~
Toggle_check_box(showIndexMenus, handle(Show_index_menus));~
~
~
/* Update ShowTitle */~
var shwTitle := true;~
if (FindInText( "Show_title: *No", awpAttrib, re:true, caseInsensitive:true )) then (shwTitle:=false);~
Toggle_check_box(shwTitle, handle(ShowTitle));~
~
/* update  Description Checkbox */~
var shwDescCheckBox := true;~
if (FindInText( "show_description: *0", awpAttrib, re:true, caseInsensitive:true )) then (shwDescCheckBox:=false);~
Toggle_check_box(shwDescCheckBox, handle(ShowDescription));~
~
/* hide or make visible choice input for Description length? */~
if (shwDescCheckBox) then set_z_level(handle(DescLengthFormNode), 5) else set_z_level(handle(DescLengthFormNode), -5);~
~
/* If there is no "HideDescription:## flag, the make the choice visible and set it's value to 30% */~
if (shwDescCheckBox) then ~
(~
  Definition of Description_length := 'Choice(self,3,0)';~
~
   /* if show description flag present, then set choice list value accordingly */~
   var descPercent := FindInText( "show_description: *(\d+)", awpAttrib , re:true, caseInsensitive:true, return:'S', subpattern: 1) ;~
   if (descPercent = "10") then ( Definition of Description_length := 'Choice(self,1,0)');~
   if (descPercent = "20") then ( Definition of Description_length := 'Choice(self,2,0)');~
   if (descPercent = "30") then ( Definition of Description_length := 'Choice(self,3,0)');~
   if (descPercent = "40") then ( Definition of Description_length := 'Choice(self,4,0)');~
   if (descPercent = "50") then ( Definition of Description_length := 'Choice(self,5,0)');~
   if (descPercent = "60") then ( Definition of Description_length := 'Choice(self,6,0)');~
   if (descPercent = "80") then ( Definition of Description_length := 'Choice(self,7,0)');~
   0;~
) ~
else~
(~
  0~
);~
~
/* Finally, set the choice input for 'Table or graph?' */~
Definition of Table_or_graph_ := 'Choice(table_or_graph_opts,1,0,result:@(table_or_graph_opts))';~
if ( FindInText( "Graph_only", awpAttrib , caseInsensitive:true)            ) then ( Definition of Table_or_graph_ := 'Choice(table_or_graph_opts,2,0,result:@(table_or_graph_opts))');~
if ( FindInText( "Table_only", awpAttrib , caseInsensitive:true)             ) then ( Definition of Table_or_graph_ := 'Choice(table_or_graph_opts,3,0,result:@(table_or_graph_opts))');~
if ( FindInText( "Table_over_graph", awpAttrib , caseInsensitive:true) ) then ( Definition of Table_or_graph_ := 'Choice(table_or_graph_opts,4,0,result:@(table_or_graph_opts))');~
if ( FindInText( "Graph_over_table", awpAttrib , caseInsensitive:true)  ) then ( Definition of Table_or_graph_ := 'Choice(table_or_graph_opts,5,0,result:@(table_or_graph_opts))');~
0~

