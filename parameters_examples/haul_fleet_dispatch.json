{
  "wasim_version": "0.9.7",
  "name": "Haul Fleet — Dispatch Policy Comparison (wear-levelling vs naive vs cohorting)",
  "description": "Stage-3b: isolates the DISPATCH policy (spec 1.3). Every step exactly one available truck is assigned the overload (300 t); the rest run nominal (240 t). `dispatch_policy` selects WHICH truck: 0 = naive round-robin (damage-blind rotation), 1 = wear-levelling (least-damaged available truck, argmin_where), 2 = deliberate cohorting (lowest-index available truck — sacrifice T01, then T02, …). Run the model three times, once per policy value, and compare `damage_spread` over time and `available_trucks` at horizon. Insight: wear-levelling keeps the fleet balanced (low peak spread) but ages every truck together toward a clustered failure; cohorting drives a large imbalance and sacrifices one truck early, keeping the rest young and staggering failures predictably. Damage scale calibrated so a truck overloaded EVERY step (cohorting's T01) fails ~mid-horizon while nominal-only trucks survive. See STAGE3B_DISPATCH_POLICY.md.",
  "source": { "generator": "hand-authored-scenario" },

  "simulation_settings": {
    "duration": { "value": 3, "unit": "yr" },
    "timestep": { "value": 1, "unit": "wk" },
    "n_realizations": 400,
    "sampling_method": "lhs",
    "seed": 20260729
  },

  "dimensions": [
    { "id": "Fleet", "name": "Fleet", "size": 6,
      "labels": ["T01", "T02", "T03", "T04", "T05", "T06"] }
  ],

  "elements": [
    { "id": "beta", "name": "Load exponent (damage power law)",
      "primitive": "node", "value_rule": "sample",
      "distribution": { "family": "triangular", "parameters": {
        "min":  { "value": 2.5, "unit": "1" },
        "mode": { "value": 3.0, "unit": "1" },
        "max":  { "value": 4.0, "unit": "1" } } },
      "save_results": { "final_value": true } },

    { "id": "dispatch_policy", "name": "Dispatch policy (0 naive / 1 wear-level / 2 cohort)",
      "primitive": "node", "value_rule": "fixed", "editable": true,
      "value": { "value": 1, "unit": "1" },
      "description": "The scenario switch. Set 0 / 1 / 2 across three runs to compare." },

    { "id": "dmg_scale", "name": "Per-step damage scale",
      "primitive": "node", "value_rule": "fixed",
      "value": { "value": 0.0055, "unit": "1" },
      "description": "Nominal per-step damage. Nominal life 1/0.0055 ~= 182 wk (> 156 wk horizon → nominal trucks survive); an always-overloaded truck at beta=3 wears 1.25^3 ~= 1.95x → fails ~93 wk (mid-horizon)." },

    { "id": "truck_index", "name": "Per-truck 1-based index",
      "primitive": "node", "value_rule": "expression",
      "outputs": [{ "name": "TruckIndex", "unit": "1", "dimensions": ["Fleet"] }],
      "expression": { "ast": { "op": "vector_map", "over": "Fleet",
        "body": { "op": "index_ref", "axis": "row" } } },
      "description": "[1,2,3,4,5,6] — the coordinate vector, used by the cohort dispatch (argmin picks the lowest available index)." },

    { "id": "available", "name": "Per-truck availability mask",
      "primitive": "node", "value_rule": "expression", "inputs": ["failed"],
      "outputs": [{ "name": "Available", "unit": "1", "dimensions": ["Fleet"] }],
      "expression": { "ast": { "op": "vector_map", "over": "Fleet",
        "body": { "op": "subtract",
          "left":  { "op": "literal", "value": 1 },
          "right": { "op": "index", "array": { "op": "ref", "element_id": "failed" },
                     "indices": [{ "op": "index_ref", "axis": "row" }] } } } } },

    { "id": "damage_prev", "name": "Damage (previous step)",
      "primitive": "node", "value_rule": "lag",
      "outputs": [{ "name": "DamagePrev", "unit": "1", "dimensions": ["Fleet"] }],
      "input": "damage", "initial": { "value": 0, "unit": "1" } },

    { "id": "target_wl", "name": "Target — wear-levelling",
      "primitive": "node", "value_rule": "expression", "inputs": ["damage_prev", "available"],
      "expression": { "ast": { "op": "call", "fn": "argmin_where",
        "args": [{ "op": "ref", "element_id": "damage_prev" }, { "op": "ref", "element_id": "available" }] } },
      "description": "Least-damaged AVAILABLE truck." },

    { "id": "target_cohort", "name": "Target — cohorting",
      "primitive": "node", "value_rule": "expression", "inputs": ["truck_index", "available"],
      "expression": { "ast": { "op": "call", "fn": "argmin_where",
        "args": [{ "op": "ref", "element_id": "truck_index" }, { "op": "ref", "element_id": "available" }] } },
      "description": "Lowest-index available truck — sacrifice T01 until it fails, then T02, … (concentrates damage)." },

    { "id": "target_naive", "name": "Target — naive round-robin",
      "primitive": "node", "value_rule": "expression",
      "expression": { "ast": { "op": "add",
        "left": { "op": "call", "fn": "mod", "args": [
          { "op": "call", "fn": "floor", "args": [
            { "op": "add",
              "left": { "op": "divide",
                "left": { "op": "time_ref", "property": "elapsed" },
                "right": { "op": "time_ref", "property": "timestep" } },
              "right": { "op": "literal", "value": 0.5 } } ] },
          { "op": "literal", "value": 6 } ] },
        "right": { "op": "literal", "value": 1 } } },
      "description": "(step mod N) + 1 via floor(elapsed/dt) — damage-blind, availability-blind rotation. Each truck is overloaded every 6th step, so overload spreads evenly by count (but blind to who is already damaged)." },

    { "id": "overload_target", "name": "Truck chosen to overload",
      "primitive": "node", "value_rule": "expression",
      "inputs": ["dispatch_policy", "target_naive", "target_wl", "target_cohort"],
      "expression": { "ast": { "op": "if",
        "cond": { "op": "lt", "left": { "op": "ref", "element_id": "dispatch_policy" }, "right": { "op": "literal", "value": 0.5 } },
        "then": { "op": "ref", "element_id": "target_naive" },
        "else": { "op": "if",
          "cond": { "op": "lt", "left": { "op": "ref", "element_id": "dispatch_policy" }, "right": { "op": "literal", "value": 1.5 } },
          "then": { "op": "ref", "element_id": "target_wl" },
          "else": { "op": "ref", "element_id": "target_cohort" } } } },
      "save_results": { "time_history": true } },

    { "id": "payload", "name": "Per-truck payload (t)",
      "primitive": "node", "value_rule": "expression", "inputs": ["overload_target"],
      "outputs": [{ "name": "Payload", "unit": "1", "dimensions": ["Fleet"] }],
      "expression": { "ast": { "op": "vector_map", "over": "Fleet",
        "body": { "op": "if",
          "cond": { "op": "eq", "left": { "op": "ref", "element_id": "overload_target" }, "right": { "op": "index_ref", "axis": "row" } },
          "then": { "op": "literal", "value": 300 },
          "else": { "op": "literal", "value": 240 } } } },
      "description": "The overload target hauls 300 t; everyone else 240 t.",
      "save_results": { "time_history": true } },

    { "id": "damage_rate", "name": "Per-truck damage rate",
      "primitive": "node", "value_rule": "expression", "inputs": ["payload", "beta", "dmg_scale", "failed"],
      "outputs": [{ "name": "DamageRate", "unit": "1", "dimensions": ["Fleet"] }],
      "expression": { "ast": { "op": "vector_map", "over": "Fleet",
        "body": { "op": "multiply",
          "left": { "op": "subtract", "left": { "op": "literal", "value": 1 },
                    "right": { "op": "index", "array": { "op": "ref", "element_id": "failed" },
                              "indices": [{ "op": "index_ref", "axis": "row" }] } },
          "right": { "op": "multiply",
            "left": { "op": "power",
              "left": { "op": "divide",
                "left": { "op": "index", "array": { "op": "ref", "element_id": "payload" },
                          "indices": [{ "op": "index_ref", "axis": "row" }] },
                "right": { "op": "literal", "value": 240 } },
              "right": { "op": "ref", "element_id": "beta" } },
            "right": { "op": "ref", "element_id": "dmg_scale" } } } } },
      "description": "(1-failed) * (payload/240)^beta * scale, per step, per truck." },

    { "id": "damage", "name": "Per-truck cumulative damage",
      "primitive": "node", "value_rule": "expression", "inputs": ["damage_prev", "damage_rate"],
      "outputs": [{ "name": "Damage", "unit": "1", "dimensions": ["Fleet"] }],
      "expression": { "ast": { "op": "vector_map", "over": "Fleet",
        "body": { "op": "add",
          "left": { "op": "index", "array": { "op": "ref", "element_id": "damage_prev" },
                    "indices": [{ "op": "index_ref", "axis": "row" }] },
          "right": { "op": "index", "array": { "op": "ref", "element_id": "damage_rate" },
                     "indices": [{ "op": "index_ref", "axis": "row" }] } } } },
      "save_results": { "time_history": true, "final_value": true } },

    { "id": "failed", "name": "Per-truck failed flag",
      "primitive": "node", "value_rule": "status",
      "outputs": [{ "name": "Failed", "unit": "1", "dimensions": ["Fleet"] }],
      "set": { "mode": "on_condition", "condition": { "ast": { "op": "gte",
        "left": { "op": "index", "array": { "op": "ref", "element_id": "damage_prev" },
                  "indices": [{ "op": "index_ref", "axis": "row" }] },
        "right": { "op": "literal", "value": 1.0 } } } },
      "reset": { "mode": "on_condition", "condition": { "ast": { "op": "literal", "value": 0 } } },
      "save_results": { "time_history": true, "final_value": true } },

    { "id": "damage_spread", "name": "Damage spread (max - min)",
      "primitive": "node", "value_rule": "expression", "inputs": ["damage"],
      "expression": { "ast": { "op": "subtract",
        "left": { "op": "call", "fn": "max_array", "args": [{ "op": "ref", "element_id": "damage" }] },
        "right": { "op": "call", "fn": "min_array", "args": [{ "op": "ref", "element_id": "damage" }] } } },
      "description": "Fleet imbalance. Wear-levelling keeps it low; cohorting drives it high.",
      "save_results": { "time_history": true, "final_value": true } },

    { "id": "damage_mean", "name": "Mean fleet damage",
      "primitive": "node", "value_rule": "expression", "inputs": ["damage"],
      "expression": { "ast": { "op": "call", "fn": "mean_array", "args": [{ "op": "ref", "element_id": "damage" }] } },
      "save_results": { "time_history": true, "final_value": true } },

    { "id": "failed_count", "name": "Trucks failed",
      "primitive": "node", "value_rule": "expression", "inputs": ["failed"],
      "expression": { "ast": { "op": "call", "fn": "sum_array", "args": [{ "op": "ref", "element_id": "failed" }] } },
      "save_results": { "time_history": true, "final_value": true } },

    { "id": "available_trucks", "name": "Available trucks",
      "primitive": "node", "value_rule": "expression", "inputs": ["failed"],
      "expression": { "ast": { "op": "subtract",
        "left": { "op": "call", "fn": "size_array", "args": [{ "op": "ref", "element_id": "failed" }] },
        "right": { "op": "call", "fn": "sum_array", "args": [{ "op": "ref", "element_id": "failed" }] } } },
      "save_results": { "time_history": true, "final_value": true } }
  ]
}
